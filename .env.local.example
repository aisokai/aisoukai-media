# Anthropic API キー（https://console.anthropic.com/ で取得）
# .env.local にコピーして実際のキーを設定してください
ANTHROPIC_API_KEY=sk-ant-ここにキーを貼り付けてください

# サイト URL（sitemap.xml / OGP などで使用）
NEXT_PUBLIC_SITE_URL=https://example.com

# Admin review actions
ADMIN_REVIEW_PASSWORD=
ADMIN_REVIEW_COOKIE_SECRET=
GITHUB_REVIEW_TOKEN=
GITHUB_REVIEW_REPO=aisokai/aisoukai-media
GITHUB_REVIEW_BRANCH=main
