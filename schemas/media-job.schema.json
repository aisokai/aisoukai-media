{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "media-job.schema.json",
  "title": "Media Queue Job",
  "description": "全メディア投稿・返信・通知の共通queue item。enumは scripts/lib/media-queue.mjs と同期。mutableフィールドは status/updated_at/approved_by/approved_at/executed_at/external_result/error/retry_count のみ。履歴は logs/media-automation.jsonl に append-only で残す。",
  "type": "object",
  "required": [
    "id", "type", "source", "source_text", "target_channels", "status",
    "risk_level", "gate_policy", "created_at", "updated_at"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^mj-\\d{8}-\\d{6}-[a-z0-9]{4}$" },
    "type": {
      "enum": [
        "blog_article", "sns_repurpose", "gmb_update", "gmb_emergency_notice",
        "gmb_campaign", "temporary_closure_notice", "schedule_change_notice",
        "review_reply", "internal_notice", "lineworks_instruction", "telegram_instruction",
        "delete_review_reply", "delete_gmb_post"
      ]
    },
    "source": { "enum": ["telegram", "lineworks", "cron", "blog", "manual", "watcher"] },
    "source_text": { "type": "string", "description": "元指示の原文。秘密値はredact済みであること" },
    "target_channels": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "blog", "instagram", "x", "line_official", "gmb", "website_notice",
          "internal_print", "lineworks_internal", "telegram_internal", "obsidian"
        ]
      }
    },
    "status": {
      "enum": [
        "draft_requested", "draft_generated", "review_pending", "approved",
        "rejected", "scheduled", "executed", "failed", "archived", "human_required"
      ]
    },
    "risk_level": { "enum": ["low", "medium", "high"] },
    "gate_policy": {
      "enum": ["auto", "auto_after_notify", "auto_when_enabled", "human_gate", "forbidden"],
      "description": "config/media-gate.json の表引き結果の最厳値。AIが緩和してはならない"
    },
    "gate_by_channel": { "type": "object", "description": "channel別のgate_policy内訳" },
    "created_at": { "type": "string" },
    "updated_at": { "type": "string" },
    "approved_by": { "type": ["string", "null"], "description": "human:<名前> または auto:<policy名>" },
    "approved_at": { "type": ["string", "null"] },
    "executed_at": { "type": ["string", "null"] },
    "output_paths": { "type": "array", "items": { "type": "string" } },
    "external_result": { "type": ["object", "null"], "description": "投稿ID・返信ID等。秘密値redact済み" },
    "error": { "type": ["object", "string", "null"] },
    "retry_count": { "type": "integer", "minimum": 0, "description": "上限3。超過で human_required" }
  }
}
