{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "sns-draft.schema.json",
  "title": "SNS Draft (frontmatter)",
  "description": "content/sns-drafts/*.md のfrontmatter仕様。実装上の正本は scripts/lib/sns-drafts.mjs (既存)。publish_mode は manual_only (Human 手動投稿承認) と ai_mutual_review (AI 相互監視、証拠照合は scripts/lib/sns-mutual-review.mjs) の2値。このスキーマ・検証は投稿を実行しない。",
  "type": "object",
  "required": [
    "channel", "platform", "title", "date", "status", "reviewed",
    "approved_for_manual_post", "ai_generated", "medical_risk",
    "source_topic_id", "publish_mode"
  ],
  "properties": {
    "channel": { "enum": ["instagram", "x", "line", "youtube", "website", "threads", "facebook"] },
    "platform": { "enum": ["instagram", "x", "line", "youtube", "website", "threads", "facebook"] },
    "title": { "type": "string", "minLength": 1 },
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "status": { "enum": ["draft", "pending_review", "approved", "rejected", "posted", "archived"] },
    "reviewed": { "type": "boolean" },
    "approved_for_manual_post": { "type": "boolean" },
    "ai_generated": { "type": "boolean" },
    "medical_risk": { "enum": ["low", "medium", "high"] },
    "source_topic_id": { "type": "string" },
    "source_post": { "type": "string", "description": "横展開元のブログ記事ファイル名" },
    "media_job_id": { "type": "string", "description": "対応する media queue job の id" },
    "notice_type": { "enum": ["temporary_closure_notice", "schedule_change_notice"], "description": "お知らせ投稿の種別 (任意)。指定時は本文の日付・曜日・時刻を frontmatter の date と照合する" },
    "publish_mode": { "enum": ["manual_only", "ai_mutual_review"] },
    "created_by": { "type": "string", "pattern": "^[^:\\s]+:\\S+$", "description": "作成AIの identity (<system>:<run-id>)。ai_mutual_review では必須、manual_only では指定不可" },
    "media_files": { "type": "array", "items": { "type": "string" }, "description": "投稿に使うメディア実ファイルの repo 相対パス一覧 (public/images/ 配下のみ)。sns-content-hash/v1 の算出対象" },
    "mutual_review": {
      "type": "object",
      "description": "相互監視の状態ブロック (正本)。ai_mutual_review では必須、manual_only では指定不可",
      "required": ["state"],
      "properties": {
        "state": { "enum": ["pending", "passed", "changes_requested", "escalated"] },
        "content_hash": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
        "evidence_id": { "type": ["string", "null"] },
        "reviewed_by": { "type": ["string", "null"] },
        "reviewed_at": { "type": ["string", "null"] },
        "exception_category": { "enum": ["patient_identifiable", "individual_consultation", "complaint", "reviewer_disagreement", "other", null] }
      }
    }
  }
}
