# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.local.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# research output (human-review candidates, not committed by default)
data/research/
public/images/library/inbox/

# Telegram runtime session state (volatile, not version-controlled)
data/telegram-session.json

# Telegram launchd runtime logs
logs/telegram-ops.log
logs/telegram-ops-error.log
logs/*.log
logs/ops-mwf.lock
logs/notification-dedupe/

# internal superpowers planning docs (not version-controlled)
docs/superpowers/plans/

# Media Automation runtime artifacts (generated locally, not version-controlled)
tmp/
data/media-status.json
logs/archive/
config/gmb-location.json
content/media-queue/mj-*.json
content/gmb-drafts/mj-*
content/gmb-reviews/snapshots/
content/gmb-reviews/replies/
content/gmb-reviews/processed-ids.json
content/emergency-drafts/mj-*
content/lineworks-requests/lw-*.json
logs/media-automation.jsonl
